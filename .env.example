# Required — generate each with: openssl rand -hex 32
ENCRYPTION_KEY=
SESSION_SECRET=

# Where users will reach the proxy / console (defaults fine for local)
NEXT_PUBLIC_PROXY_URL=http://localhost:8787
PUBLIC_BASE_URL=http://localhost:3000

# Optional — Google sign-in
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# Optional — transactional email (verification, weekly savings reports,
# keep-alive budget alerts)
#RESEND_API_KEY=
#EMAIL_FROM=Caching.ai <hello@your-domain.com>

# Optional — postpaid billing pipeline (hosted-cloud feature; leave off)
#BILLING_LIVE=1
#STRIPE_SECRET_KEY=
#TOSS_SECRET_KEY=

# Optional — Prometheus metrics at GET /metrics (off unless set)
#   scrape with: authorization: Bearer <token>
#METRICS_TOKEN=

# Optional — raw request-log retention in days (default 100; 0 = keep forever).
# Complete days are rolled up into request_logs_daily before pruning. Values
# 1-89 are floored to 90: the console's 90-day window and open-month billing
# recompute both read raw rows.
#LOG_RETENTION_DAYS=100

# Optional — proxy port and upstream overrides (defaults shown; only set these
# to route through a regional mirror or another compatible gateway)
#PORT=8080
#UPSTREAM_URL=https://api.anthropic.com
#OPENAI_UPSTREAM_URL=https://api.openai.com
#GEMINI_UPSTREAM_URL=https://generativelanguage.googleapis.com
#GROK_UPSTREAM_URL=https://api.x.ai

# Optional — where the proxy's auth-error messages point users (your console)
#CONSOLE_URL=http://localhost:3000/console/keys

# Optional — ops-only: POST /admin/test-report (x-admin-token header) sends the
# current weekly report to OPS_REPORT_EMAIL. Both must be set to enable.
#ADMIN_TOKEN=
#OPS_REPORT_EMAIL=

# Optional — hot-path API-key cache TTL in ms (default 30000). Key setting
# changes and revocations take up to this long to propagate.
#KEY_CACHE_TTL_MS=30000
